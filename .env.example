NEXT_PUBLIC_SITE_URL=https://robogoalindia.com
# PostgreSQL is required in production. Development uses a local SQLite database.
DATABASE_URL=
# Generate a random secret with at least 32 characters; never use NEXT_PUBLIC_ here.
ADMIN_TOKEN=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
ADMIN_EMAIL=
# Enable once approved privacy and terms documents are published.
POLICIES_APPROVED=false
# Cloudflare Turnstile; production submissions require these keys.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Django content service. Required in production container deployments.
CMS_INTERNAL_URL=http://127.0.0.1:8000
CMS_REQUIRED=false
# Set true ONLY behind a private proxy that overwrites X-RGI-Client-IP.
TRUST_PROXY=false
RATE_LIMIT_SECRET=
