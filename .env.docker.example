# Copy to .env.docker, generate DIFFERENT secrets, and never commit that file.
NEXT_PUBLIC_SITE_URL=https://robogoalindia.com
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
POSTGRES_DB=rgi
POSTGRES_USER=rgi
# URL-safe random values only, or URL-encode credentials in DATABASE_URL.
POSTGRES_PASSWORD=
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=robogoalindia.com,www.robogoalindia.com,backend,localhost
DJANGO_CSRF_TRUSTED_ORIGINS=https://robogoalindia.com,https://www.robogoalindia.com
RATE_LIMIT_SECRET=
ADMIN_TOKEN=
POLICIES_APPROVED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
ADMIN_EMAIL=
# Bind only to loopback; a trusted TLS terminator forwards to this port.
HTTP_PORT=8080
TRUSTED_EDGE_CIDR=127.0.0.1/32
